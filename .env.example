# Neon connection strings — see README for setup steps.
# Pooled connection, used by the app at runtime:
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require"
# Direct (non-pooled) connection, used only for running migrations:
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/dbname?sslmode=require"

# Admin login — see README for how to generate ADMIN_PASSWORD_HASH.
ADMIN_USERNAME="changeme"
ADMIN_PASSWORD_HASH="$2b$10$replace-with-a-real-bcrypt-hash"

# Any long random string (e.g. `openssl rand -hex 32`).
SESSION_SECRET="replace-with-a-long-random-string"
