# Neon connection strings — see README for setup steps.
# Pooled connection, used by the app at runtime:
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require"
# Direct (non-pooled) connection, used only for running migrations:
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/dbname?sslmode=require"

# Admin login bootstrap — see README for how to generate ADMIN_PASSWORD_HASH.
# These are only used to create the admin login the very first time anyone
# logs in; after that, the real credential lives in the database and is
# changed in-app via "Change Login", not by editing these values.
#
# IMPORTANT (local .env files only): Next.js expands "$word" in .env files as
# a variable reference, and bcrypt hashes are full of "$"-delimited segments
# (e.g. $2b$10$...). Escape every "$" as "\$" here or Next.js will silently
# strip parts of the hash and login will fail. This does NOT apply to
# variables entered directly in the Vercel dashboard — only to .env files
# Next.js parses itself.
ADMIN_USERNAME="changeme"
ADMIN_PASSWORD_HASH="\$2b\$10\$replace-with-a-real-bcrypt-hash"

# Any long random string (e.g. `openssl rand -hex 32`).
SESSION_SECRET="replace-with-a-long-random-string"
